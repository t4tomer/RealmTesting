<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RealmTodo.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RealmTodo.Views"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate local:LoginPage}"
        Route="login" />

    <ShellContent
        Title="ItemsList"
        ContentTemplate="{DataTemplate local:ItemsPage}"
        Route="list_of_items" />

    <ShellContent
        Title="MapNames"
        ContentTemplate="{DataTemplate local:MapNamesPage}"
        Route="list_of_maps" />





</Shell>

